# Copy this file to ".env" and fill in the values. ".env" is git-ignored.
#
# FridgeMate talks to Claude models through Amazon Bedrock. Authentication uses
# the normal AWS credential chain, so the simplest setup is an AWS CLI SSO
# profile (see README) and just naming it here.

# Name of the AWS profile in ~/.aws/config to use for Bedrock calls.
AWS_PROFILE=fridgemate

# Region where the Bedrock models are reachable for this account.
# The hackathon account's service control policy blocks APAC regions, so we use us-west-2.
AWS_REGION=us-west-2

# Optional: override the model ids from src/fridgemate/config.py.
# Leave unset to use the defaults (Claude Haiku 4.5 / Sonnet 4.5 US inference profiles).
# FRIDGEMATE_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# FRIDGEMATE_MODEL_SMART=us.anthropic.claude-sonnet-4-5-20250929-v1:0
